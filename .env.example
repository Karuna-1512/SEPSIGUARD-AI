# Copy to .env and replace secrets before sharing or deploying.
APP_NAME=SepsiGuard AI
ENVIRONMENT=development
DATABASE_URL=sqlite:///./sepsiguard.db
SECRET_KEY=change-this-local-secret-before-deployment
SESSION_HOURS=12

# Optional first-run administrator bootstrap. Use a unique password of at least 12 characters.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=SepsiGuard Administrator

MODEL_PATH=models/sepsis_gru.keras
SCALER_PATH=models/scaler.pkl
FEATURE_SCHEMA_PATH=models/feature_schema.json
METRICS_PATH=models/metrics.json

# Research category boundaries only; not clinically validated thresholds.
LOW_THRESHOLD=0.30
HIGH_THRESHOLD=0.70
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=10

# Docker Compose PostgreSQL values (local development only).
POSTGRES_DB=sepsiguard
POSTGRES_USER=sepsiguard
POSTGRES_PASSWORD=change-me-local-only
